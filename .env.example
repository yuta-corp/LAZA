# Base de données PostgreSQL (adapter l'hôte / le mot de passe)
DATABASE_URL="postgresql://postgres@localhost:5432/laza?schema=public"

# Vercel Blob — preuves stockées à distance (URL publiques).
# Sur Vercel, l'authentification se fait automatiquement via OIDC.
# En local, ajouter le token de lecture-écriture du store (vercel env pull).
# BLOB_READ_WRITE_TOKEN=""

# URL publique utilisée pour le partage sur les réseaux sociaux
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clerk — authentification de l'espace de modération (/admin)
# Voir https://clerk.com/docs/nextjs (installation : npx clerk@latest init)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/admin"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/admin"

# ⚠️ Dashboard Clerk obligatoire pour le rôle admin :
# Sessions → Customize session token → { "metadata": "{{user.public_metadata}}" }
# puis Users → <utilisateur> → Public metadata → { "role": "admin" } (ou pnpm db:promote <email>)
