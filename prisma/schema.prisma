// Laza — Plateforme de dénonciation anonyme de corruption
// Modèle de données — Prisma 7

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReportStatus {
  SUBMITTED
  UNDER_REVIEW
  PUBLISHED
  REJECTED
}

enum Category {
  MARCHES_PUBLICS
  FONCIER
  DOUANES_IMPOTS
  SANTE
  EDUCATION
  JUSTICE
  SECURITE
  MINES
  TELECOMS
  ENERGIE
  AUTRE
}

enum EvidenceKind {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  LINK
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CommentStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Report {
  id          String       @id @default(cuid())
  slug        String       @unique
  reference   String       @unique // ex: LAZ-2026-0001
  title       String
  summary     String
  description String
  category    Category
  region      String?
  status      ReportStatus @default(SUBMITTED)

  // Engagement d'identité (couche ZKP) — seul un hash est stocké, jamais la donnée brute.
  identityCommitment String?
  commitmentSalt     String?

  // Avertissement légal (Art. 373.1 — dénonciation abusive)
  legalAccepted   Boolean  @default(false)
  legalAcceptedAt DateTime?

  // Modération (équipe de confiance — pré-modération)
  moderationNote String?
  reviewedBy     String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  rejectedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence  Evidence[]
  comments  Comment[]
  likes     ReportLike[]

  @@index([status, createdAt])
  @@index([category])
  @@index([publishedAt])
}

/**
 * Identité locale (auth de base SHA + salt) : l'empreinte ne quitte jamais le
 * navigateur, seul le hash sha256(CIN | naissance | salt) est stocké.
 * Chaque pseudo public est rattaché à une empreinte unique.
 */
model Identity {
  id          String   @id @default(cuid())
  fingerprint String   @unique // sha256(secretLocal | salt) — secret stocké en cookie, jamais au serveur
  salt        String // salt ayant servi à dériver l'empreinte (conservé pour correspondance)
  pseudo      String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments Comment[]
}

/**
 * Commentaire public sur un signalement (fil de discussion, façon réseau social).
 * Pré-modération : un commentaire n'est visible qu'après validation par l'équipe.
 */
model Comment {
  id             String        @id @default(cuid())
  report         Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId       String
  identity       Identity?     @relation(fields: [identityId], references: [id])
  identityId     String?
  authorName     String? // pseudo snapshot au moment de la contribution
  content        String
  status         CommentStatus @default(PENDING)
  moderationNote String?
  reviewedBy     String?
  reviewedAt     DateTime?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@index([reportId, status])
  @@index([status, createdAt])
  @@index([identityId])
}

/** Soutien (like) anonyme : un seul par visiteur (empreinte stockée en cookie). */
model ReportLike {
  id          String   @id @default(cuid())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId    String
  fingerprint String
  createdAt   DateTime @default(now())

  @@unique([reportId, fingerprint])
  @@index([reportId])
}

model Evidence {
  id                 String             @id @default(cuid())
  report             Report             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId           String
  kind               EvidenceKind
  fileName           String
  mimeType           String
  size               Int
  storagePath        String? // TODO: champ obsolète, abandonné au profit de `url` (Vercel Blob)
  url                String? // URL publique (Vercel Blob) des fichiers, ou lien pour les preuves de type lien
  checksum           String // SHA-256 calculé côté client (intégrité)
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())

  @@index([reportId])
  @@index([verificationStatus])
}